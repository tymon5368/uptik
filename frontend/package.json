{
  "name": "frontend",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vite build",
    "preview": "vite preview",
    "compile:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.1",
    "@inlang/paraglide-vite": "^1.4.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.4.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.6.0"
  }
}